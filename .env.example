# ==============================================================================
# Nexo Medico AI — Environment Configuration Template
# Duplicate this file as `.env` or `.env.local` for local execution.
# NEVER commit real credentials, passwords, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Local PostgreSQL default connection string format:
# postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://nexo_user:your_secure_password@localhost:5432/nexo_medico_ai?schema=public"

# Direct URL used for migrations or pooled setups (optional in local development)
DIRECT_URL="postgresql://nexo_user:your_secure_password@localhost:5432/nexo_medico_ai?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# A strong, cryptographically random secret string used to sign session JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_jwt_secret_key_minimum_32_chars"

# Base URL of the web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AI & Clinical Decision Support Microservice (FastAPI)
# ------------------------------------------------------------------------------
# URL of the Python FastAPI service (runs on port 8000 by default)
AI_SERVICE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# 4. Email Service & 2FA OTP Delivery (Gmail SMTP)
# ------------------------------------------------------------------------------
# Gmail SMTP configuration for transactional OTPs and notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# Authenticated Gmail address used to dispatch verification codes
SMTP_USER="your-organization-account@gmail.com"

# 16-character Google App Password generated in Google Account Security settings
# DO NOT use your standard personal Google account password
SMTP_APP_PASSWORD="your-16-char-app-password"

# Sender header displayed in patient inbox
EMAIL_FROM="Nexo Medico AI <your-organization-account@gmail.com>"

# ------------------------------------------------------------------------------
# 5. SMS Gateway Configuration (Optional / Development Fallback)
# ------------------------------------------------------------------------------
# Optional Twilio credentials for SMS fallback; leave blank or false in development
ENABLE_DEV_SMS="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

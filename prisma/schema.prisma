datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Hospital {
  id               String   @id @default(uuid())
  name             String
  type             String   // e.g. General, Multi-Specialty, Academic, Community
  registrationNo   String   @unique
  email            String   @unique
  phone            String
  address          String
  city             String
  state            String
  country          String
  pinCode          String?
  website          String?
  emergencyContact String
  deptCount        Int      @default(0)
  bedCount         Int      @default(0)
  status           String   @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  departments        Department[]
  staffProfiles      StaffProfile[]
  doctorProfiles     DoctorProfile[]
  nurseProfiles      NurseProfile[]
  patients           Patient[]
  medicalRecords     MedicalRecord[]
  appointments       Appointment[]
  consultations      Consultation[]
  prescriptions      Prescription[]
  medicines          Medicine[]
  pharmacyInventory  PharmacyInventory[]
  dispensingLogs     DispensingLog[]
  labTests           LabTest[]
  labOrders          LabOrder[]
  labReports         LabReport[]
  medicalImages      MedicalImage[]
  wards              Ward[]
  beds               Bed[]
  admissions         Admission[]
  discharges         Discharge[]
  icuUnits           ICUUnit[]
  icuBedLogs         ICUBedLog[]
  aiPredictionLogs   AIPredictionLog[]
  auditLogs          AuditLog[]
  supportIssues      SupportIssue[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // SUPER_ADMIN, HOSPITAL_ADMIN, DOCTOR, NURSE, RECEPTIONIST, PHARMACIST, LAB_TECH, RADIOLOGY_TECH, ICU_STAFF, HR_ADMIN, PATIENT
  phone        String?
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile    StaffProfile?
  doctorProfile   DoctorProfile?
  nurseProfile    NurseProfile?
  patientProfile  Patient?        @relation("UserPatient")
  userPermissions UserPermission[]
  auditLogs       AuditLog[]
  dispensingLogs  DispensingLog[] @relation("DispensedBy")
  supportIssues       SupportIssue[]        @relation("UserSupportIssues")
  assignedTickets     SupportIssue[]        @relation("AssignedTickets")
  supportMessages     SupportMessage[]      @relation("UserSupportMessages")
  supportTicketEvents SupportTicketEvent[]  @relation("ActorTicketEvents")
  passwordResetTokens PasswordResetToken[]
  doctorAppointments  Appointment[]
  otpChallenges       OtpChallenge[]
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. PATIENT_VIEW, PRESCRIPTION_CREATE
  name        String
  description String?
  module      String

  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)

  @@unique([userId, permissionId])
}

model Department {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  code         String
  name         String
  description  String?
  location     String?
  contact      String?
  headDoctorId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  staffProfiles  StaffProfile[]
  doctorProfiles DoctorProfile[]
  appointments   Appointment[]
  admissions     Admission[]

  @@unique([hospitalId, code])
}

model StaffProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  employeeId   String
  designation  String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  joiningDate  DateTime    @default(now())
  status       String      @default("ACTIVE")

  @@unique([hospitalId, employeeId])
}

model DoctorProfile {
  id               String      @id @default(uuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId       String
  hospital         Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  employeeId       String
  qualification    String
  specialization   String
  registrationNo   String
  experienceYears  Int         @default(0)
  consultationFee  Float       @default(0.0)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  slotConfigJson   String?     // JSON of working hours & slots
  status           String      @default("ACTIVE")

  @@unique([hospitalId, employeeId])
}

model NurseProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  employeeId     String
  assignedWardId String?
  shift          String   @default("DAY") // DAY, NIGHT, ROTATING
  status         String   @default("ACTIVE")

  @@unique([hospitalId, employeeId])
}

model Patient {
  id               String   @id @default(uuid())
  patientCode      String   @unique // e.g. NEXO-PAT-000001
  hospitalId       String
  hospital         Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId           String?  @unique
  user             User?    @relation("UserPatient", fields: [userId], references: [id])
  fullName         String
  dob              String
  gender           String
  phone            String
  email            String?
  address          String
  emergencyContact String
  bloodGroup       String
  allergies        String?  // Comma-separated or text
  conditions       String?  // Existing chronic conditions
  previousHistory  String?  // Past medical history

  // India-Only Address Fields
  houseFlat                 String?
  streetArea                String?
  landmark                  String?
  villageWard               String?
  mandalTaluk               String?
  city                      String?
  district                  String?
  state                     String?
  country                   String?  @default("IN")
  pinCode                   String?

  // Dedicated Emergency Contact Fields
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?

  // Emergency QR Profile
  emergencyProfile          PatientEmergencyProfile?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  medicalRecords       MedicalRecord[]
  appointments         Appointment[]
  consultations        Consultation[]
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  labReports           LabReport[]
  medicalImages        MedicalImage[]
  admissions           Admission[]
  discharges           Discharge[]
  icuBedLogs           ICUBedLog[]
  aiPredictionLogs     AIPredictionLog[]
  drugInteractionAlerts DrugInteractionAlert[]
}

model PatientEmergencyProfile {
  id                    String                  @id @default(uuid())
  patientId             String                  @unique
  patient               Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  publicToken           String                  @unique // Cryptographically secure random token
  shortId               String                  @unique // e.g. EMG-7829-1940
  status                String                  @default("ACTIVE") // ACTIVE, REVOKED
  
  // Patient-Controlled Privacy Flags
  shareName             Boolean                 @default(true)
  sharePhone            Boolean                 @default(false)
  shareEmergencyContact Boolean                 @default(true)
  shareBloodGroup       Boolean                 @default(true)
  shareAllergies        Boolean                 @default(true)
  shareConditions       Boolean                 @default(true)
  shareAddress          Boolean                 @default(false) // Home address hidden by default
  shareEmergencyNote    Boolean                 @default(true)
  sharePatientCode      Boolean                 @default(true)
  shareDob              Boolean                 @default(true)

  emergencyNote         String?                 // Concise emergency medical note

  // Consent & Audit
  consentGiven          Boolean                 @default(true)
  consentGivenAt        DateTime                @default(now())
  consentVersion        String                  @default("1.0")
  revokedAt             DateTime?
  lastRegeneratedAt     DateTime?
  viewCount             Int                     @default(0)
  lastViewedAt          DateTime?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  auditLogs             EmergencyProfileAudit[]

  @@index([publicToken])
  @@index([shortId])
  @@index([status])
}

model EmergencyProfileAudit {
  id                    String                  @id @default(uuid())
  profileId             String
  profile               PatientEmergencyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  action                String                  // CREATED, SETTINGS_UPDATED, REGENERATED, REVOKED, VIEWED
  details               String?                 // JSON payload describing the event
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                @default(now())

  @@index([profileId])
  @@index([action])
}

model MedicalRecord {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorId   String?
  visitDate  DateTime @default(now())
  recordType String   // DIAGNOSIS, CONSULTATION, PROCEDURE, LAB_RESULT, DISCHARGE_SUMMARY
  title      String
  summary    String
  details    String?
  createdAt  DateTime @default(now())
}

model Appointment {
  id                 String       @id @default(uuid())
  appointmentCode    String       @unique
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             User         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  hospitalId         String
  hospital           Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date               String       // YYYY-MM-DD
  timeSlot           String       // e.g. 10:00 AM
  durationMinutes    Int          @default(30)
  visitType          String       @default("IN_PERSON") // IN_PERSON, TELECONSULTATION
  type               String       @default("GENERAL") // GENERAL, FOLLOW_UP, EMERGENCY, ROUTINE, SPECIALIST
  status             String       @default("BOOKED") // BOOKED, CONFIRMED, CHECKED_IN, IN_CONSULTATION, COMPLETED, CANCELLED, NO_SHOW, RESCHEDULED
  reason             String
  notes              String?
  diagnosisNotes     String?
  cancellationReason String?
  rejectionReason    String?
  checkedInAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  historyJson        String?      // Audit history of status changes
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  consultations   Consultation[]

  @@unique([doctorId, date, timeSlot], map: "unique_doctor_date_slot")
}

model Consultation {
  id            String      @id @default(uuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  hospitalId    String
  hospital      Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  symptoms      String
  vitalsBp      String?
  vitalsHr      String?
  vitalsTemp    String?
  vitalsSpo2    String?
  vitalsRr      String?
  clinicalNotes String
  diagnosis     String
  status        String      @default("COMPLETED")
  createdAt     DateTime    @default(now())

  prescriptions Prescription[]
}

model Prescription {
  id               String             @id @default(uuid())
  prescriptionCode String             @unique // e.g. RX-2026-0001
  consultationId   String?
  consultation     Consultation?      @relation(fields: [consultationId], references: [id])
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  hospitalId       String
  hospital         Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date             DateTime           @default(now())
  status           String             @default("DRAFT") // DRAFT, ISSUED, DISPENSED, CANCELLED
  instructions     String?
  digitalSignature String?
  createdAt        DateTime           @default(now())

  items                 PrescriptionItem[]
  dispensingLogs        DispensingLog[]
  drugInteractionAlerts DrugInteractionAlert[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicineName   String
  strength       String       // e.g. 500 mg
  dosage         String       // e.g. 1 tablet
  route          String       // Oral, IV, Topical
  frequency      String       // Twice daily, 8 hourly
  durationDays   Int          // e.g. 5
  quantity       Int          // e.g. 10
  foodRelation   String       // After food, Before food
  instructions   String?
}

model DrugInteractionAlert {
  id             String        @id @default(uuid())
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  severity       String        // HIGH, MEDIUM, LOW, CRITICAL
  warningMessage String
  drugsInvolved  String
  createdAt      DateTime      @default(now())
}

model Medicine {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  code         String
  name         String
  genericName  String
  category     String   // Antibiotic, Analgesic, Antipyretic, Cardiovascular, etc.
  manufacturer String
  storageInfo  String?
  status       String   @default("ACTIVE")

  inventoryItems PharmacyInventory[]

  @@unique([hospitalId, code])
}

model PharmacyInventory {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNo      String
  expiryDate   String   // YYYY-MM-DD
  quantity     Int
  reorderLevel Int      @default(10)
  unitPrice    Float
  status       String   @default("IN_STOCK") // IN_STOCK, LOW_STOCK, EXPIRING_SOON, EXPIRED, OUT_OF_STOCK
  updatedAt    DateTime @updatedAt
}

model DispensingLog {
  id             String       @id @default(uuid())
  hospitalId     String
  hospital       Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  dispensedByUserId String
  dispensedByUser User        @relation("DispensedBy", fields: [dispensedByUserId], references: [id])
  dispensedAt    DateTime     @default(now())
  status         String       @default("COMPLETED")
  notes          String?
}

model LabTest {
  id             String   @id @default(uuid())
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  code           String
  name           String
  category       String   // Hematology, Biochemistry, Pathology, Radiology, Microbiology
  sampleType     String   // Blood, Urine, Sputum, Swab, Tissue
  price          Float    @default(0.0)
  referenceRange String?

  orders LabOrder[]

  @@unique([hospitalId, code])
}

model LabOrder {
  id          String    @id @default(uuid())
  orderCode   String    @unique
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  testId      String
  test        LabTest   @relation(fields: [testId], references: [id])
  testName    String
  priority    String    @default("ROUTINE") // ROUTINE, URGENT, STAT
  status      String    @default("ORDERED") // ORDERED, SAMPLE_COLLECTED, PROCESSING, REPORT_READY, VERIFIED
  orderedAt   DateTime  @default(now())

  report LabReport?
}

model LabReport {
  id               String    @id @default(uuid())
  orderId          String    @unique
  order            LabOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  labTechUserId    String?
  reportDataJson   String    // Measured lab values
  ocrExtractedText String?
  abnormalFlagsJson String?  // Flagged out of range items
  summary          String
  aiInterpretation String?
  status           String    @default("REPORT_READY") // REPORT_READY, VERIFIED
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model MedicalImage {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorId    String?
  studyType   String   // Chest X-Ray, Brain MRI, Skin Lesion, Bone Fracture
  bodyPart    String
  imagePath   String
  aiDiagnosis String?
  confidence  Float?
  heatmapPath String?
  status      String   @default("UPLOADED")
  createdAt   DateTime @default(now())
}

model Ward {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  code       String
  name       String
  type       String   // General, Private, SemiPrivate, Emergency, ICU
  totalBeds  Int      @default(0)
  status     String   @default("ACTIVE")

  beds       Bed[]
  admissions Admission[]

  @@unique([hospitalId, code])
}

model Bed {
  id         String   @id @default(uuid())
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedNumber  String
  status     String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING, MAINTENANCE

  admissions Admission[]
  icuLogs    ICUBedLog[]

  @@unique([wardId, bedNumber])
}

model Admission {
  id               String     @id @default(uuid())
  admissionCode    String     @unique
  patientId        String
  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId       String
  hospital         Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  doctorId         String
  wardId           String
  ward             Ward       @relation(fields: [wardId], references: [id])
  bedId            String
  bed              Bed        @relation(fields: [bedId], references: [id])
  admissionReason  String
  diagnosis        String
  admissionDate    DateTime   @default(now())
  expectedDischarge String?
  emergencyStatus  Boolean    @default(false)
  status           String     @default("ADMITTED") // ADMITTED, DISCHARGED, TRANSFERRED

  discharge Discharge?
}

model Discharge {
  id                    String    @id @default(uuid())
  admissionId           String    @unique
  admission             Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId             String
  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId            String
  hospital              Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorId              String
  dischargeDate         DateTime  @default(now())
  dischargeReason       String
  diagnosis             String
  hospitalCourse        String
  followUpInstructions  String
  dischargeSummaryText  String
}

model ICUUnit {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  code       String
  capacity   Int      @default(5)
  location   String

  @@unique([hospitalId, code])
}

model ICUBedLog {
  id                 String   @id @default(uuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedId              String
  bed                Bed      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String?
  nurseId            String?
  recordedAt         DateTime @default(now())
  vitalsJson         String   // BP, HR, Temp, SpO2, RR, GCS
  ventilatorSettings String?
  nurseNotes         String?
}

model AIPredictionLog {
  id                    String   @id @default(uuid())
  hospitalId            String
  hospital              Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String?
  modelType             String   // Diabetes, Heart, Kidney, Liver, Stroke, Hypertension
  inputParamsJson       String
  riskScore             Float
  predictedCondition    String
  confidence            Float
  featureImportanceJson String
  explainabilityText    String
  createdAt             DateTime @default(now())
}

model SupportIssue {
  id              String   @id @default(uuid())
  ticketCode      String   @unique // e.g. NMX-TKT-2026-000123
  hospitalId      String?
  hospital        Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?     @relation("UserSupportIssues", fields: [userId], references: [id], onDelete: SetNull)
  userRole        String?   @default("USER")
  registeredName  String
  mobile          String
  email           String
  issueType       String   @default("TECHNICAL") // TECHNICAL, HOSPITAL_ONBOARDING, BILLING, GENERAL, CLINICAL
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  subject         String
  description     String
  attachmentUrl   String?  // Image data URL or path
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_USER, WAITING_FOR_SUPPORT, RESOLVED, CLOSED
  assignedToId    String?
  assignedTo      User?    @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminResponse       String?
  resolvedAt          DateTime?
  closedAt            DateTime?
  emailStatus         String?   @default("PENDING") // PENDING, SENT, FAILED
  emailSentAt         DateTime?
  emailFailureReason  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  messages            SupportMessage[]
  timelineEvents      SupportTicketEvent[]
}

model SupportMessage {
  id            String       @id @default(uuid())
  ticketId      String
  ticket        SupportIssue @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?        @relation("UserSupportMessages", fields: [senderId], references: [id], onDelete: SetNull)
  senderRole    String       // SUPER_ADMIN, HOSPITAL_ADMIN, DOCTOR, PATIENT, etc.
  senderName    String
  message       String
  attachmentUrl String?
  isInternal    Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model SupportTicketEvent {
  id          String       @id @default(uuid())
  ticketId    String
  ticket      SupportIssue @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?        @relation("ActorTicketEvents", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   String
  actorName   String
  type        String       // STATUS_CHANGED, ASSIGNED, MESSAGE_POSTED, REOPENED, CLOSED, CREATED
  oldStatus   String?
  newStatus   String?
  description String
  createdAt   DateTime     @default(now())
}

model RAGKnowledgeDoc {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String
  sourceUrl String?
  tags      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  hospitalId  String?
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g. PATIENT_VIEW, PRESCRIPTION_CREATE, DISPENSE_MEDICINE
  resource    String   // e.g. Patient:NEXO-PAT-000001
  detailsJson String?
  ipAddress   String?
  timestamp   DateTime @default(now())
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  channel    String    @default("email") // email or phone
  otpHash    String    // Hashed 6-digit OTP
  resetToken String    @unique // Single-use authorization token
  attempts   Int       @default(0) // Failed verification attempts
  expiresAt  DateTime  // 5 minutes expiry
  usedAt     DateTime? // Timestamp when consumed
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([phone])
  @@index([resetToken])
}

model OtpChallenge {
  id             String    @id @default(uuid())
  email          String
  purpose        String    // REGISTRATION, LOGIN, PASSWORD_RESET
  otpHash        String    // Bcrypt hash of the 6-digit OTP
  challengeToken String    @unique // Unique secure token (hex or UUID)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadataJson   String?   // JSON storing pending registration payload or login context
  attempts       Int       @default(0) // Failed attempt counter, max 5
  expiresAt      DateTime  // 5 minutes from generation
  consumedAt     DateTime? // When successfully verified
  createdAt      DateTime  @default(now())

  @@index([email, purpose])
  @@index([challengeToken])
}

